{
  "name": "wisesplit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build && wrangler dev",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "test:e2e:staging": "E2E_BASE_URL=https://staging.wisesplit.llmat.dev playwright test",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "hono": "^4.13.14",
    "jose": "^6.2.14",
    "preact": "^11.1.0",
    "preact-iso": "^2.12.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@biomejs/biome": "2.6.4",
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "preact-render-to-string": "^6.8.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.155.0"
  }
}
