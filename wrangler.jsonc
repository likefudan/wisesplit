{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wisesplit",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wisesplit",
      // Filled in by CI from the account's D1 database list; this placeholder works for local dev and tests.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": { "SITE_ORIGIN": "https://wisesplit.llmat.dev", "ENVIRONMENT": "production" },
  "routes": [{ "pattern": "wisesplit.llmat.dev", "custom_domain": true }],
  "observability": { "enabled": true },

  // Test site: its own Worker, database and domain. Every merge to main lands here;
  // production only changes when a v* release tag is pushed (see .github/workflows/ci.yml).
  "env": {
    "staging": {
      "name": "wisesplit-staging",
      "assets": {
        "directory": "./dist/web",
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/robots.txt"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "wisesplit-staging",
          // Filled in by CI like the production one above.
          "database_id": "11111111-1111-1111-1111-111111111111",
          "migrations_dir": "migrations"
        }
      ],
      "vars": { "SITE_ORIGIN": "https://staging.wisesplit.llmat.dev", "ENVIRONMENT": "staging" },
      "routes": [{ "pattern": "staging.wisesplit.llmat.dev", "custom_domain": true }],
      "observability": { "enabled": true }
    }
  }
}
